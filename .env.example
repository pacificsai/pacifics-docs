# Pacifics docs environment variables
# Copy this file to .env.local and fill in real values.
# .env.local is gitignored and must never be committed.

# Base URL where the docs site is served
SITE_URL=https://docs.pacifics.in

# Base path the site is served under (use "/" for root)
BASE_URL=/

# Pacifics API base URL (used by API examples / integrations)
PACIFICS_API_URL=https://api.pacifics.in/v1

# API token for authenticated examples (do NOT commit a real token)
PACIFICS_API_TOKEN=

# Optional analytics / search keys
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX_NAME=
